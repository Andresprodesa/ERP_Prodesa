# =====================================================================
# ERP Prodesa - variables de entorno de EJEMPLO (copiar a .env)
# TODOS los valores son de DESARROLLO / PRUEBA. No usar en producción.
# .env NUNCA se versiona (está en .gitignore).
# =====================================================================

ENVIRONMENT=local

# --- Base de datos ---
# Prototipo (por defecto, sin instalar nada): SQLite en backend/erp_prodesa.db
# DATABASE_URL=sqlite:///./erp_prodesa.db
# Perfil prod-like (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://erp:cambiar-dev-pg@localhost:5432/erp_prodesa
POSTGRES_DB=erp_prodesa
POSTGRES_USER=erp
POSTGRES_PASSWORD=cambiar-dev-pg
POSTGRES_PORT=5432

# --- Autenticación (prototipo: JWT local) ---
AUTH_PROVIDER=local
# Secreto de PRUEBA. En producción: valor aleatorio >= 32 caracteres desde un gestor de secretos.
JWT_SECRET=dev-solo-local-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Futuro: Microsoft Entra ID ---
# AUTH_PROVIDER=entra
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=

# --- CORS (frontend Vite) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Usuarios de PRUEBA creados por `python -m app.seed` (solo local) ---
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=cambiar-dev-admin
DEV_USERS_PASSWORD=cambiar-dev-usuarios
