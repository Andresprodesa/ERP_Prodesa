# =====================================================================
# ERP Prodesa - variables de entorno de EJEMPLO (copiar a .env)
# TODOS los valores son de DESARROLLO / PRUEBA. No usar en producción.
# .env NUNCA se versiona (está en .gitignore).
# =====================================================================

ENVIRONMENT=local

# --- Base de datos ---
# Prototipo (por defecto, sin instalar nada): SQLite en backend/erp_prodesa.db
# DATABASE_URL=sqlite:///./erp_prodesa.db
# Perfil prod-like (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://erp:cambiar-dev-pg@localhost:5432/erp_prodesa
POSTGRES_DB=erp_prodesa
POSTGRES_USER=erp
POSTGRES_PASSWORD=cambiar-dev-pg
POSTGRES_PORT=5432
# Interfaz donde docker compose publica los puertos (127.0.0.1 = solo este equipo).
BIND_ADDR=127.0.0.1

# --- Autenticación (prototipo: JWT local) ---
AUTH_PROVIDER=local
# Genere uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
# - ENVIRONMENT=local/test: vacío = se genera uno aleatorio y se guarda en backend/.jwt_secret.local
# - docker compose y cualquier otro entorno (staging, ci, production): OBLIGATORIO, >= 32 caracteres
#   (en producción, desde un gestor de secretos). El valor de ejemplo antiguo ya no se acepta.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Futuro: Microsoft Entra ID ---
# AUTH_PROVIDER=entra
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=

# --- CORS (frontend Vite) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Usuarios de PRUEBA creados por `python -m app.seed` (solo local) ---
# Vacías = el seed genera contraseñas aleatorias al crear los usuarios y las imprime una vez.
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=
DEV_USERS_PASSWORD=
